APP_NAME=GOROS
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
APP_DESCRIPTION=Enterprise AI Operating System backend foundation for GOROS.
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/goros
DATABASE_ECHO=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

JWT_SECRET=
ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379/0

MODEL_ALIAS_CHAT_FAST_PROVIDER=ollama
MODEL_ALIAS_CHAT_FAST_MODEL=qwen3:8b
MODEL_ALIAS_CHAT_PREMIUM_PROVIDER=openai
MODEL_ALIAS_CHAT_PREMIUM_MODEL=gpt-5.5
MODEL_ALIAS_REASONING_PROVIDER=anthropic
MODEL_ALIAS_REASONING_MODEL=claude-opus
MODEL_ALIAS_VISION_PROVIDER=ollama
MODEL_ALIAS_VISION_MODEL=llama3.2-vision
MODEL_ALIAS_EMBEDDINGS_PROVIDER=ollama
MODEL_ALIAS_EMBEDDINGS_MODEL=nomic-embed-text

OPENAPI_CONTACT_NAME=GOROS Platform Team
OPENAPI_CONTACT_EMAIL=platform@goros.dev
OPENAPI_LICENSE_NAME=Proprietary
OPENAPI_LICENSE_URL=https://goros.local/license
